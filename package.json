{
  "name": "swagger-tools",
  "version": "1.0.0",
  "description": "Swagger/OpenAPI spec parser",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "swagger-tools": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "cli": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types src/cli.ts api.json",
    "skill:install": "mkdir -p \"$HOME/.codebuddy/skills\" && rm -rf \"$HOME/.codebuddy/skills/swagger-request-codegen\" && cp -R skills/swagger-request-codegen \"$HOME/.codebuddy/skills/\"",
    "skill:package": "mkdir -p dist-skills && rm -f dist-skills/swagger-request-codegen.zip && cd skills && zip -qr ../dist-skills/swagger-request-codegen.zip swagger-request-codegen",
    "skill:typecheck": "tsc -p skills/swagger-request-codegen/tsconfig.json"
  },
  "keywords": [
    "swagger",
    "openapi",
    "parser"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  },
  "volta": {
    "node": "24.7.0"
  },
  "dependencies": {
    "pinyin-pro": "^3.28.1"
  }
}
